# Copy to .env and adjust before running docker compose.

# --- Postgres ---
POSTGRES_USER=survey
POSTGRES_PASSWORD=survey_dev_password
POSTGRES_DB=survey

# --- API ---
# Built from the Postgres vars above; must match the db service.
DATABASE_URL=postgres://survey:survey_dev_password@db:5432/survey
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN_TTL=4h
SESSION_TOKEN_TTL=30m
FUZZY_MATCH_THRESHOLD=0.8
OTP_EXPIRY_MINUTES=2
PORT=4000

# Single hardcoded admin account (seeded into the DB on API startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
